[Unit]
Description=LAB mistral.rs gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/Users/danvoulez/lab-mistral-rs-gateway
ExecStart=/usr/bin/env node src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/opt/homebrew/bin:/Users/danvoulez/.cargo/bin:/usr/bin:/bin:/usr/sbin:/sbin

[Install]
WantedBy=multi-user.target
